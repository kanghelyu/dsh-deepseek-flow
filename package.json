{
  "name": "deepseek-flow",
  "version": "0.3.9",
  "description": "DeepSeekFlow — per-session visual workflow plugin for DeepSeek Harness: canvas ↔ WORKFLOW.md/STEP.md two-way sync, AI review/optimize, theme-following UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "test",
    "examples",
    "qa/*v9*.png",
    "README.md",
    "QA-REPORT.md",
    "HANDOFF-0.3.5.md",
    "cordis.patch.yml",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "deps:check": "bash scripts/ensure-deps.sh",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/client-smoke.mjs",
    "check": "node --check lib/index.js && node --check lib/document-workflow.js && node --check lib/agent-assistant.js && node --check src/client/entry.js && node --test test/*.test.mjs && node scripts/build.mjs && node scripts/client-smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}